---
import Base from '../../layouts/Base.astro';
import { UI, getSettings, localeParams, type Locale } from '../../i18n';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Locale;
const t = UI[lang];
const settings = await getSettings();
---

<Base lang={lang} title={t.contact}>
  <div class="container">
    <header class="page-header">
      <h1>{t.contact}</h1>
      <p class="lead">{t.contactIntro}</p>
    </header>

    <dl class="contact">
      <div>
        <dt>{t.email}</dt>
        <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
      </div>
      {
        settings.phone && (
          <div>
            <dt>{t.phone}</dt>
            <dd>
              <a href={`tel:${settings.phone.replace(/[^+\d]/g, '')}`}>{settings.phone}</a>
            </dd>
          </div>
        )
      }
      {
        settings.facebook && (
          <div>
            <dt>{t.facebook}</dt>
            <dd>
              <a href={settings.facebook} rel="noopener">
                {t.siteTitle}
              </a>
            </dd>
          </div>
        )
      }
      <div>
        <dt>{t.location}</dt>
        <dd>{settings.location[lang]}</dd>
      </div>
    </dl>
  </div>
</Base>

<style>
  .lead {
    max-width: 36rem;
    margin: 1rem 0 0;
    font-size: 1.075rem;
    color: var(--muted);
  }

  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
    overflow: hidden;
  }

  .contact div {
    padding: 1.75rem;
    background: var(--surface);
  }

  .contact dt {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact dd {
    margin: 0.5rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    overflow-wrap: anywhere;
  }

  .contact a {
    text-decoration: none;
  }
</style>
