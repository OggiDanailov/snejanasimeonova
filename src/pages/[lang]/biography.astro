---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { localeParams, type Locale } from '../../i18n';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Locale;
const entry = await getEntry('bio', lang);
if (!entry) throw new Error(`Missing src/content/bio/${lang}.md`);
const { Content } = await render(entry);
---

<Base lang={lang} title={entry.data.title}>
  <div class="container">
    <header class="page-header">
      <h1>{entry.data.title}</h1>
    </header>
    <article class="bio">
      <Content />
    </article>
  </div>
</Base>

<style>
  .bio {
    max-width: 48rem;
  }

  .bio :global(> p:first-child) {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    line-height: 1.4;
    margin-top: 0;
  }

  .bio :global(h2) {
    margin: 3.5rem 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.9rem;
  }

  .bio :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* "**2015** Exhibition name" → year in its own column */
  .bio :global(li) {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-block: 0.45rem;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
  }

  .bio :global(li strong) {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
</style>
