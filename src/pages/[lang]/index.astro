---
import { Image, getImage } from 'astro:assets';
import { CATEGORIES } from '../../content.config';
import Base from '../../layouts/Base.astro';
import { UI, getSettings, getWorks, localeParams, type Locale } from '../../i18n';
import { rotated, rotationFor } from '../../lib/rotation';

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Locale;
const t = UI[lang];
const settings = await getSettings();
const heroRotate = await rotationFor(settings.heroImage);
const hero = rotated(settings.heroImage, heroRotate);

// Slideshow: upright photos from both sculpture sections, shown in random
// order after the hero photo (wide photos would crop badly in the frame).
const caption = (title: string, year?: number) => (year ? `${title}, ${year}` : title);
const sculptures = [...(await getWorks('monumental')), ...(await getWorks('small'))];
const heroWork = sculptures.find((w) => w.data.image.src === settings.heroImage.src);
const slides = await Promise.all(
  sculptures
    .filter((w) => w !== heroWork)
    .map((w) => ({ work: w, image: rotated(w.data.image, w.data.rotate) }))
    .filter(({ image }) => image.height >= image.width)
    .map(async ({ work, image }) => ({
      src: (await getImage({ src: image, rotate: work.data.rotate, width: Math.min(image.width, 1000), format: 'webp' })).src,
      caption: caption(work.data.title[lang], work.data.year),
    })),
);
const heroCaption = heroWork ? caption(heroWork.data.title[lang], heroWork.data.year) : '';

const categories = await Promise.all(
  CATEGORIES.map(async (category) => ({
    category,
    count: (await getWorks(category)).length,
    cover: settings.covers[category],
    coverRotate: await rotationFor(settings.covers[category]),
  })),
);
---

<Base lang={lang}>
  <section class="hero container">
    <div class="hero__text">
      <p class="eyebrow">{settings.tagline[lang]}</p>
      <h1>{t.siteTitle}</h1>
      <p class="hero__intro">{settings.intro[lang]}</p>
      <div class="hero__actions">
        <a class="button" href={`/${lang}/monumental/`}>{t.viewWorks}</a>
        <a class="button button--ghost" href={`/${lang}/biography/`}>{t.biography}</a>
      </div>
    </div>
    <figure class="hero__image" data-slides={JSON.stringify(slides)}>
      <div class="hero__frame">
        <Image
          class="hero__slide is-active"
          src={hero}
          rotate={heroRotate}
          alt={heroCaption}
          widths={[600, 900, 1200]}
          sizes="(min-width: 56rem) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <img class="hero__slide" alt="" aria-hidden="true" decoding="async" />
      </div>
      {heroCaption && <figcaption class="hero__caption">{heroCaption}</figcaption>}
    </figure>
  </section>

  <section class="categories container" aria-labelledby="works-heading">
    <h2 id="works-heading" class="eyebrow">{t.works}</h2>
    <ul>
      {
        categories.map(({ category, count, cover, coverRotate }) => (
          <li>
            <a class="category-card" href={`/${lang}/${category}/`}>
              <div class="category-card__image">
                <Image src={rotated(cover, coverRotate)} rotate={coverRotate} alt="" widths={[400, 700]} sizes="(min-width: 48rem) 33vw, 100vw" />
              </div>
              <h3>{t[category]}</h3>
              <p>{t.workCount(count)}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  // Crossfades the hero photo every 5 seconds through the slides listed in
  // data-slides. Two <img> layers take turns: the next photo is loaded into
  // the hidden one and only shown once it's ready.
  const INTERVAL = 5_000;
  const figure = document.querySelector<HTMLElement>('.hero__image');
  const slides: { src: string; caption: string }[] = JSON.parse(figure?.dataset.slides ?? '[]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (figure && slides.length && !reduceMotion) {
    const layers = [...figure.querySelectorAll<HTMLImageElement>('.hero__slide')];
    const caption = figure.querySelector('.hero__caption');
    // Shuffle so returning visitors see different works.
    for (let i = slides.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [slides[i], slides[j]] = [slides[j], slides[i]];
    }
    let next = 0;
    let visible = 0;

    async function advance() {
      if (document.hidden) return; // don't change photos nobody is looking at
      const slide = slides[next];
      next = (next + 1) % slides.length;
      const incoming = layers[1 - visible];
      // The hero <img> has a responsive srcset; the other layer uses a plain src.
      incoming.removeAttribute('srcset');
      incoming.removeAttribute('sizes');
      incoming.src = slide.src;
      try {
        await incoming.decode();
      } catch {
        return; // skip a photo that fails to load
      }
      incoming.alt = slide.caption;
      incoming.removeAttribute('aria-hidden');
      layers[visible].classList.remove('is-active');
      layers[visible].alt = '';
      layers[visible].setAttribute('aria-hidden', 'true');
      incoming.classList.add('is-active');
      if (caption) caption.textContent = slide.caption;
      visible = 1 - visible;
    }

    setInterval(advance, INTERVAL);
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 5.75rem);
    line-height: 0.98;
  }

  .hero__intro {
    max-width: 34rem;
    margin: 1.5rem 0 2rem;
    font-size: 1.075rem;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__image {
    margin: 0;
  }

  .hero__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 80vh;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__caption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .categories {
    padding-top: clamp(2rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .categories ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .category-card {
    display: block;
    text-decoration: none;
  }

  .category-card__image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .category-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .category-card:hover img {
    transform: scale(1.04);
  }

  .category-card h3 {
    margin-top: 1rem;
    font-size: 1.6rem;
  }

  .category-card p {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
