---
import Gallery from '../../components/Gallery.astro';
import { CATEGORIES, type Category } from '../../content.config';
import Base from '../../layouts/Base.astro';
import { LOCALES, UI, getWorks, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => CATEGORIES.map((category) => ({ params: { lang, category } })));
}

const lang = Astro.params.lang as Locale;
const category = Astro.params.category as Category;
const t = UI[lang];
const works = await getWorks(category);
---

<Base lang={lang} title={t[category]}>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">{t.workCount(works.length)}</p>
      <h1>{t[category]}</h1>
    </header>
    <Gallery works={works} lang={lang} />
  </div>
</Base>
